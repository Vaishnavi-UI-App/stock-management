# Database connection (MySQL)
DATABASE_URL="mysql://username:password@localhost:3306/stock_management"

# JWT Secret for authentication
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Server configuration
PORT=3001
NODE_ENV=development

# Public URL of the frontend — used to build links inside emails
# (password setup / reset). Set to your domain in production.
APP_URL="http://localhost:5173"

# Email (SMTP). Leave SMTP_HOST unset to run in "console" mode, where emails are
# logged to the server console instead of being delivered. Fill these in to send
# real email (e.g. Gmail: host smtp.gmail.com, port 587, user = your address,
# pass = a 16-char Google App Password).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="you@example.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="DynamicIndia ERP <you@example.com>"
